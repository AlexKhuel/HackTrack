# Repo-wide environment variables
# Fill with your actual values

# Supabase Postgres connection string (used by Supabase-Pipeline)
SUPABASE_DB_URL=

# Aviationstack API Key for flight schedule fetching
AERODATABOX_API_KEY=

# Google OAuth web client ID used by the API to verify Google ID tokens
GOOGLE_CLIENT_ID=

# Optional additional Google OAuth client IDs accepted by the API
# (for example native iOS client IDs)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Secret used by the API to sign user session JWTs
AUTH_JWT_SECRET=

# OpenNote OAuth + API integration
OPENNOTE_CLIENT_ID=
OPENNOTE_CLIENT_SECRET=
OPENNOTE_AUTHORIZATION_URL=
OPENNOTE_TOKEN_URL=
OPENNOTE_API_BASE_URL=
OPENNOTE_USERINFO_URL=
OPENNOTE_OAUTH_REDIRECT_URI=
OPENNOTE_OAUTH_SCOPES=journals.write journals.read profile offline_access
OPENNOTE_TOKEN_ENCRYPTION_KEY=
OPENNOTE_WEB_BASE_URL=
OPENNOTE_DEFAULT_RETURN_PATH=/?view=results
OPENNOTE_JOURNAL_CREATE_PATH=/journals
OPENNOTE_JOURNAL_UPDATE_PATH_TEMPLATE=/journals/{id}
OPENNOTE_OAUTH_STATE_TTL_SECONDS=900
